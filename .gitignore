# Dependencies
/node_modules/
/.pnp
.pnp.*
/.npm/
/.pnpm-store/
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
/build/
/.cache/
/.turbo/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/
/test-results/
/playwright-report/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
*.pid
*.pid.lock

# Local environment and keys
.env*
.dev.vars*
*.pem
*.key
*.p12
*.pfx

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store
._*
Thumbs.db

# Local editor state and temporary files
/.idea/
*.swp
*.swo
*~

# Safe configuration template (contains no secrets)
!.env.example
